{
  "name": "lumen",
  "version": "0.1.0",
  "dependencies": [],
  "features": {
    "dashboard": {
      "description": "FTXUI terminal dashboard (LUMEN_ENABLE_DASHBOARD=ON)",
      "dependencies": [
        {
          "name": "ftxui",
          "platform": "!windows"
        }
      ]
    },
    "tests": {
      "description": "GoogleTest, for the test suite only (LUMEN_BUILD_TESTS=ON)",
