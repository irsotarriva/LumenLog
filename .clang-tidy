# clang-tidy 18 configuration. Enforces the naming and style rules of AGENTS.md.
#
# Run it with the `lint` target, which passes the flags below:
#   cmake --build build/debug --target lint
# or by hand on a build directory with compile_commands.json:
#   run-clang-tidy -p build/debug -quiet \
#     -extra-arg=-D__cpp_concepts=202002L -extra-arg=-Wno-builtin-macro-redefined \
#     -extra-arg=-Wno-unknown-warning-option '/(src|examples|tests|python)/'
# The __cpp_concepts definition is needed only against GNU libstdc++ 13, whose
# <expected> Clang 18 otherwise rejects; drop it with libc++.
#
# Every check family is enabled and each exclusion below states why. A check
# that reports only a few true exceptions stays enabled, and each exception
# carries a NOLINT with its reason.
Checks: >
  -*,
  bugprone-*,
  cert-*,
  concurrency-*,
  cppcoreguidelines-*,
  google-explicit-constructor,
  misc-*,
  modernize-*,
  performance-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -cert-dcl21-cpp,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -misc-include-cleaner,
  -modernize-return-braced-init-list,
  -modernize-use-trailing-return-type,
  -readability-identifier-length,
  -readability-magic-numbers

# Reasons for the exclusions above, in the same order:
#   bugprone-easily-swappable-parameters      reports (key, value) string_view parameter pairs
#                                             (ScopeGuard, the tag formatters) and test helpers
#                                             taking several counts; the pairs are the interface.
#   cert-dcl21-cpp                            asks for const postfix ++ results, which defeats
#                                             move semantics; removed upstream in clang-tidy 19.
#   cppcoreguidelines-avoid-magic-numbers     alias of readability-magic-numbers, below.
#   cppcoreguidelines-pro-bounds-constant-array-index
#                                             reports every std::array and span subscript by a
#                                             computed index (ring buffer slots, lookup tables) and
#                                             offers gsl::at() instead; the project uses no GSL.
#   misc-include-cleaner                      asks for a direct include of the header declaring
#                                             each name used: mostly Lumen names that a source
#                                             reaches through the header documenting them
#                                             (lumen/lumen.hpp, lumen/core.hpp).
#   modernize-return-braced-init-list         `return {a, b};` hides the type being returned.
#   modernize-use-trailing-return-type        the project uses leading return types.
#   readability-identifier-length             i, e, os, ts are clearer than longer names in short
#                                             scopes.
#   readability-magic-numbers                 reports every literal width, sample value and
#                                             test input; named constants are left to review.

HeaderFilterRegex: '.*/(include/lumen|src|python)/.*'
FormatStyle: file

CheckOptions:
  # Short functions: AGENTS.md asks for single-purpose functions.
  - key: readability-function-cognitive-complexity.Threshold
    value: 15
  # Each GTest EXPECT_* expands to branches that are not the test's own logic.
  - key: readability-function-cognitive-complexity.IgnoreMacros
    value: true
  # Plain aggregates (records, configs) may have public data.
  - key: misc-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic
    value: true
  - key: cppcoreguidelines-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic
    value: true
  # Function-like macros are allowed only for the logging front end, which
  # needs std::source_location and statement semantics.
  - key: cppcoreguidelines-macro-usage.AllowedRegexp
    value: '^(LUMEN_|LOG_)'
  - key: cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor
    value: true
  # LUMEN_LOG_FATAL needs do { } while (false) for statement semantics; the
  # check would report it wherever the macro is used.
  - key: cppcoreguidelines-avoid-do-while.IgnoreMacros
    value: true

  # Types and concepts: PascalCase.
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.UnionCase
    value: CamelCase
  - key: readability-identifier-naming.EnumCase
    value: CamelCase
  - key: readability-identifier-naming.ConceptCase
    value: CamelCase
  - key: readability-identifier-naming.TypeAliasCase
    value: CamelCase
  - key: readability-identifier-naming.TypedefCase
    value: CamelCase
  - key: readability-identifier-naming.TemplateParameterCase
    value: CamelCase
  # Scoped enums with PascalCase enumerators.
  - key: readability-identifier-naming.EnumConstantCase
    value: CamelCase

  # Functions, variables, parameters: snake_case.
  - key: readability-identifier-naming.FunctionCase
    value: lower_case
  - key: readability-identifier-naming.MethodCase
    value: lower_case
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-identifier-naming.ParameterCase
    value: lower_case
  - key: readability-identifier-naming.ConstexprVariableCase
    value: lower_case
  - key: readability-identifier-naming.GlobalConstantCase
    value: lower_case

  # Members: public snake_case, private snake_case_, protected _snake_case.
  - key: readability-identifier-naming.MemberCase
    value: lower_case
  - key: readability-identifier-naming.PrivateMemberCase
    value: lower_case
  - key: readability-identifier-naming.PrivateMemberSuffix
    value: _
  - key: readability-identifier-naming.ProtectedMemberCase
    value: lower_case
  - key: readability-identifier-naming.ProtectedMemberPrefix
    value: _
  - key: readability-identifier-naming.PrivateMethodCase
    value: lower_case
  - key: readability-identifier-naming.PrivateMethodSuffix
    value: _
  - key: readability-identifier-naming.ProtectedMethodCase
    value: lower_case
  - key: readability-identifier-naming.ProtectedMethodPrefix
    value: _

  # Macros: UPPER_CASE.
  - key: readability-identifier-naming.MacroDefinitionCase
    value: UPPER_CASE
